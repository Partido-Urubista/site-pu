generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnlinePresence {
  Slightly_Active
  Moderately_Online
  Chronically_Online
}

enum DisruptionLevel {
  Beginner
  Intermediate_Disruptor
  Master_Theorist
}

enum CurrentSituation {
  High_School
  College
  Technical_School
  Applying_To_College
  Working
  Unemployed
}

enum ApplicationStatus {
  OK
  UNUSUAL
  CLEAR
}

enum Role {
  ADMIN
  EDITOR
}

model MembershipApplication {
  id                String   @id @default(uuid())
  applicationNumber Int      @unique @default(autoincrement())
  
  youtubeId         String
  discordId         String?
  email             String
  age               Int
  state             String
  youtubeChannels   String   @db.Text
  onlinePresence    OnlinePresence
  disruptionLevel   DisruptionLevel
  politicalIdeology String
  neurodivergence   String?
  currentSituation  CurrentSituation
  howDidYouHear     String   @db.Text
  motivation        String   @db.Text

  status            ApplicationStatus @default(OK)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("membership_applications")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
